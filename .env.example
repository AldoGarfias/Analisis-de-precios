# Copia este archivo como .env.local junto a db.py y llena los valores (SIN comillas
# y SIN comentarios pegados al valor). .env.local está en .gitignore — NUNCA lo subas.

DB_ENGINE=mysql
# Endpoint READER de Aurora MySQL (solo lectura). Termina en .rds.amazonaws.com
DB_HOST_READ=
DB_PORT=3306
# Usuario de SOLO LECTURA para el pipeline
DB_USER=
DB_PASSWORD=
# Nombre del schema / base de datos
DB_DATABASE=

# --- Escritura a la BD: NO se usa en la fase de pruebas ---
# Las recomendaciones se guardan LOCALMENTE en out/ (db.guardar_recos_local).
# Cuando se habilite la escritura a tablas precio_optimo_*, descomenta y llena:
# DB_HOST_WRITE=

# API de BI (developers.syscom.mx -> Redshift) — via TITULAR
BI_CLIENT_ID=
BI_CLIENT_SECRET=
# BI_TOKEN se autogenera (python api_bi.py token) y se persiste aqui
BI_TOKEN=

# Endpoint auditado del ERP (aplicar.py)
ERP_API_URL=http://localhost:3000
ERP_API_KEY=
ERP_ACTOR_EMAIL=

# Correo (extract_competencia.py — CSVs diarios de distribuidores via IMAP)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Cohere (duelo de matching: Rerank en la zona dudosa)
COHERE_API_KEY=
